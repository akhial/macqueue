<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.macqueue.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-m</string><string>macqueue</string>
    <string>worker</string><string>--config</string>
    <string>/Users/macworker/.config/macqueue/worker.json</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/macworker/macqueue</string>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONDONTWRITEBYTECODE</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>45</integer>
  <key>StandardOutPath</key><string>/Users/macworker/macqueue-state/worker.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/macworker/macqueue-state/worker.stderr.log</string>
</dict>
</plist>

